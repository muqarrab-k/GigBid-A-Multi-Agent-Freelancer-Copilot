# Hugging Face Space (Docker SDK): web build + API with GigSim and MCP servers in-process, port 7860.

# web build
FROM node:22-slim AS web
WORKDIR /web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/web/ ./
RUN npx vite build

FROM python:3.12-slim
# spaces run as uid 1000
RUN useradd -m -u 1000 user
ENV HOME=/home/user \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/home/user/hf \
    MODEL_PROFILE=open_hosted \
    PORT=7860
WORKDIR /home/user/app

# cpu torch first, keeps the image small
RUN pip install torch==2.15.0 --index-url https://download.pytorch.org/whl/cpu
COPY pyproject.toml ./
COPY agent/ agent/
COPY apps/__init__.py apps/__init__.py
COPY apps/api/ apps/api/
COPY rag/ rag/
COPY mcp_servers/ mcp_servers/
COPY gigsim/ gigsim/
RUN pip install -e ".[embed]"

# runtime data the nodes and servers read
COPY data/personas/ data/personas/
COPY data/policy_pack/ data/policy_pack/
COPY data/processed/pricing_stats.json data/processed/scam_signals.json data/processed/
COPY --from=web /web/dist apps/web/dist

# bake the embedding model, then stay offline
RUN python -c "from agent.config import get_config; from rag.embeddings import get_embedder; get_embedder(get_config().rag.embeddings).embed_query('warm up')"
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1

RUN chown -R user:user /home/user
USER user
EXPOSE 7860
CMD ["sh", "-c", "uvicorn apps.api.main:app --host 0.0.0.0 --port ${PORT}"]
